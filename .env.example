# Neon Postgres connection string. Use the POOLED connection string
# (host contains "-pooler") so serverless functions do not exhaust connections.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Any random string of at least 32 characters. Signs the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-at-least-32-random-characters"
